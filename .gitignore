# ==============================================================================
# 1. 基础通用忽略（跨平台、跨语言的临时/系统文件）
# ==============================================================================
# 1.1 临时文件与备份文件
*~
.#*
*.*#
*.orig
*.rej
core
!core/
tags

# 1.2 系统自动生成文件（不同系统的冗余文件）
.DS_Store       # Mac 系统：文件夹属性文件
.directory      # Linux 系统：桌面配置文件
Thumbs.db       # Windows 系统：缩略图缓存
Desktop.ini     # Windows 系统：文件夹配置文件

# ==============================================================================
# 2. 编辑器/IDE 通用配置（非项目专属的编辑器缓存）
# ==============================================================================
# 2.1 VSCode
.vscode/
*.code-workspace

# 2.2 IntelliJ IDEA/CLion（Qt Creator 之外的 C++ IDE）
.idea/
*.iml
*.iws
*.ipr

# 2.3 终端编辑器
.*.swp          # Vim：临时交换文件
*.flc           # Xemacs：临时文件

# 2.4 通用自动保存文件
*.autosave

# ==============================================================================
# 3. C++ 编译核心产物（所有 C++ 项目通用的编译中间件/库）
# ==============================================================================
# 3.1 目标文件（编译后的二进制中间文件）
*.slo
*.lo
*.o
*.obj
*.core

# 3.2 库文件（静态库/动态库）
*.a
*.la
*.lai
*.so
*.so.*
*.dll
*.dylib

# 3.3 编译产物标识文件
*.debug
Makefile*
*.prl
*.app

# ==============================================================================
# 4. Qt 框架专属忽略（Qt 开发的核心生成文件/配置）
# ==============================================================================
# 4.1 Qt 编译中间文件（moc/qrc/ui 工具生成的代码）
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
*_qmlcache.qrc
*_plugin_import.cpp
object_script.*.Release
object_script.*.Debug

# 4.2 Qt 项目配置文件（qmake/Qt Creator 生成的配置）
/.qmake.cache
/.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
CMakeLists.txt.user*  # Qt Creator 关联的 CMake 配置
compile_commands.json  # QtCreator 4.8+ 编译数据库
*creator.user*         # Qt Creator 本地用户配置

# 4.3 Qt 资源/输出文件
*.qm            # Qt 翻译文件（lrelease 生成）
target_wrapper.* # Qt 单元测试包装器

# 4.4 Qt 生成的目录（编译过程中创建的临时目录）
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/
*build-*

# ==============================================================================
# 5. Visual Studio 专属忽略（VS + Qt 项目的 VS 侧生成文件）
# ==============================================================================
# 5.1 VS 核心缓存目录（解决 Git 权限错误的关键项）
.vs/

# 5.2 VS 项目配置文件（用户个性化配置/解决方案配置）
*.suo
*.user
*.userosscache
*.sln.docstates
*vcproj.*.*.user
*.vcxproj.user
*.vcxproj.filters

# 5.3 VS 编译中间文件（PDB 调试库、索引文件等）
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.ncb
*.sdf
*.opensdf
*.ipch
*.lastbuildstate

# 5.4 VS + Qt 插件相关文件
qtcdebugger*    # VS 中 Qt 调试器临时文件
QtMsBuild/      # VS 中 Qt 插件的构建配置目录

# 5.5 VS 编译输出目录（二进制产物目录，核心忽略项）
Debug/
Release/
x64/
x86/
Win32/
bin/
obj/

# 5.6 VS 资源/日志文件
*.res
*.rc
*.manifest
*.log
*.tlog
*.aps           # VS 资源文件缓存

# ==============================================================================
# 6. 其他辅助忽略（预编译头、跨语言产物、二进制可执行文件）
# ==============================================================================
# 6.1 预编译头文件
*_pch.h.cpp

# 6.2 Python 字节码（若项目包含 Python 脚本）
*.pyc

# 6.3 二进制可执行文件（所有平台的可执行程序）
*.exe